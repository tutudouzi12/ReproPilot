# Copy this file to backend.env. Strict mode is the default: missing services fail execution tasks.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3-coder-plus
OFFLINE_DEMO_MODE=false

# Python runtime
PLAN_STORE_PATH=./data/plans.json
MAX_CONCURRENT_TASKS=2
PLAN_MAX_TASK_ATTEMPTS=20
PLAN_MAX_DURATION_SECONDS=900
REQUIRE_PLAN_APPROVAL=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_ROOT=./data/uploads
UPLOAD_MAX_MB=32

# Internal Python sandbox service
SANDBOX_URL=http://localhost:8082
SANDBOX_API_TOKEN=replace-with-a-random-internal-token
SANDBOX_IMAGE=repropilot-sandbox-runtime:latest
SANDBOX_IMAGE_ALLOWLIST=repropilot-sandbox-runtime:latest,python:3.11-slim,python:3.12-slim
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_PIDS_LIMIT=128
SANDBOX_NETWORK_DISABLED=true
SANDBOX_WORKSPACE_ROOTS=/tmp
SANDBOX_EXEC_TIMEOUT_SECONDS=300
SANDBOX_MAX_OUTPUT_BYTES=1048576
SANDBOX_DOCKER_GPUS=none

# Repository execution is enabled by Compose. Local scripts leave it opt-in.
REPOSITORY_OPERATIONS_ENABLED=false
REPOSITORY_WORKSPACE_ROOT=./data/workspaces
